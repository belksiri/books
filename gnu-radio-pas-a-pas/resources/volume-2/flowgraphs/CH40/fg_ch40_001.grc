    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fg_ch40_001
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FG-CH40-001
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 150]
    rotation: 0
    state: enabled

blocks:
- name: amplitude
  id: variable
  parameters:
    comment: ''
    value: '0.5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 72]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 20]
    rotation: 0
    state: enabled
- name: afficheur
  id: qtgui_number_sink
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    color1: ("black", "black")
    color10: ("black", "black")
    color2: ("black", "black")
    color3: ("black", "black")
    color4: ("black", "black")
    color5: ("black", "black")
    color6: ("black", "black")
    color7: ("black", "black")
    color8: ("black", "black")
    color9: ("black", "black")
    comment: ''
    factor1: '1'
    factor10: '1'
    factor2: '1'
    factor3: '1'
    factor4: '1'
    factor5: '1'
    factor6: '1'
    factor7: '1'
    factor8: '1'
    factor9: '1'
    graph_type: qtgui.NUM_GRAPH_HORIZ
    gui_hint: 0,0,1,1
    label1: '"RMS"'
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '1'
    min: '0'
    name: '"RMS Level"'
    nconnections: '1'
    type: float
    unit1: '""'
    unit10: ''
    unit2: ''
    unit3: ''
    unit4: ''
    unit5: ''
    unit6: ''
    unit7: ''
    unit8: ''
    unit9: ''
    update_time: '0.10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 190]
    rotation: 0
    state: enabled
- name: debit
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 20]
    rotation: 0
    state: enabled
- name: niveau
  id: epy_block
  parameters:
    _source_code: "\"\"\"Root-mean-square level, embedded Python block of chapter\
      \ 40.\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Returns, for each sample, the RMS value of the chunk received.\"\"\
      \"\n\n    def __init__(self, threshold=0.0):\n        gr.sync_block.__init__(self,\
      \ name='RMS Level',\n                               in_sig=[np.float32], out_sig=[np.float32])\n\
      \        self.threshold = threshold\n\n    def work(self, input_items, output_items):\n\
      \        entree = input_items[0]\n        efficace = float(np.sqrt(np.mean(entree.astype(np.float64)\
      \ ** 2)))\n        output_items[0][:] = max(efficace, self.threshold)\n    \
      \    return len(output_items[0])\n"
    affinity: '[]'
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    threshold: '0.0'
  states:
    _io_cache: ('RMS Level', 'blk', [('threshold', '0.0')], [('0', 'float', 1)], [('0',
      'float', 1)], 'Returns, for each sample, the RMS value of the chunk received.',
      ['threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [20, 190]
    rotation: 0
    state: enabled
- name: source
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: amplitude
    comment: ''
    freq: '1000'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: float
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [20, 20]
    rotation: 0
    state: enabled

connections:
- [debit, '0', niveau, '0']
- [niveau, '0', afficheur, '0']
- [source, '0', debit, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
