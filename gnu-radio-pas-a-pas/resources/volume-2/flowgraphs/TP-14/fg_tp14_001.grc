connections:
- [adapte, '0', plan, '0']
- [debit_flux, '0', adapte, '0']
- [debit_flux, '0', spectre, '0']
- [egaliser, '0', debit_flux, '0']
- [moduler, '0', egaliser, '0']
- [octets, '0', moduler, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
