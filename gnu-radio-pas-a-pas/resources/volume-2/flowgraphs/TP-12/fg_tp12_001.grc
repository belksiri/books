connections:
- [channel, '0', demoduler, '0']
- [demoduler, '0', desaccentuer, '0']
- [desaccentuer, '0', level, '0']
- [level, '0', sortie_son, '0']
- [level, '0', temps, '0']
- [limiter, '0', moduler, '0']
- [moduler, '0', channel, '0']
- [recadrer, '0', limiter, '0']
- [son, '0', recadrer, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
