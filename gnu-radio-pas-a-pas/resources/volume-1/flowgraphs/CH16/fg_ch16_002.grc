options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fg_ch16_002
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FG-CH16-002
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 24]
    rotation: 0
    state: enabled

blocks:
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,2
    label: '"Frequency"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '500'
    step: '100'
    stop: '8000'
    value: '2000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 120]
    rotation: 0
    state: enabled
- name: level
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: '"Amplitude"'
    label0: ''
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    labels: '["faible", "moyen", "fort"]'
    num_opts: '0'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0.2, 0.5, 0.8]'
    orient: Qt.QVBoxLayout
    type: real
    value: '0.5'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 240]
    rotation: 0
    state: enabled
- name: marque
  id: variable_qtgui_push_button
  parameters:
    comment: ''
    gui_hint: 2,1,1,1
    label: '"Marker"'
    pressed: '1'
    released: '0'
    type: int
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 240]
    rotation: 0
    state: enabled
- name: noise
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': '0'
    gui_hint: 1,1,1,1
    label: '"Noise"'
    'true': '0.08'
    type: real
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 360]
    rotation: 0
    state: enabled
- name: note
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 3,0,1,2
    label: '"Etat"'
    type: string
    value: '"pret"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 240]
    rotation: 0
    state: enabled
- name: offset
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 2,0,1,1
    label: '"Offset"'
    type: real
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 120]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '32000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 24]
    rotation: 0
    state: enabled
