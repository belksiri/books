options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fg_ch12_001
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FG-CH12-001
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 24]
    rotation: 0
    state: enabled

blocks:
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0, 0, 1, 1
    label: '"Frequency (Hz)"'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '100'
    step: '100'
    stop: '4000'
    value: '1000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 76]
    rotation: 0
    state: enabled
- name: level
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1, 0, 1, 1
    label: '"Amplitude"'
    label0: '0.2'
    label1: '0.5'
    label2: '0.8'
    label3: ''
    label4: ''
    labels: '[''0.2'', ''0.5'', ''0.8'']'
    num_opts: '3'
    option0: '0.2'
    option1: '0.5'
    option2: '0.8'
    option3: '3'
    option4: '4'
    options: '[0.2, 0.5, 0.8]'
    orient: Qt.QHBoxLayout
    type: real
    value: '0.5'
    widget: radio_buttons
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 76]
    rotation: 0
    state: enabled
- name: nb_points
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate * 0.02)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [128, 96]
    rotation: 0
    state: enabled
- name: noise
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': '0.0'
    gui_hint: 3, 0, 1, 1
    label: '"Noise"'
    'true': '0.05'
    type: real
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 76]
    rotation: 0
    state: enabled
- name: offset
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 2, 0, 1, 1
    label: '"Offset"'
    type: real
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 76]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 96]
    rotation: 0
    state: enabled
