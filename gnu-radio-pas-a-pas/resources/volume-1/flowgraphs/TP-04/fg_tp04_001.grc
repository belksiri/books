    bus_source: false
    bus_structure: null
    coordinate: [240, 140]
    rotation: 0
    state: enabled
- name: ton
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.7'
    comment: ''
    freq: f_source
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
